# enter docker: docker run -it pipeline sh
# for docker  incremental pipeline
# use docker compose to let both docker files coexist


# Install dependencies
# this sql is to save states, not for the database service
FROM pipeline-base
RUN apt-get update && apt-get install -y \
    sqlite3 \
 && rm -rf /var/lib/apt/lists/*


# Copy app, owned by the compose user (HOST_UID/HOST_GID, default 1000) so state.db can be written
ARG APP_UID=1000
ARG APP_GID=1000
COPY --chown=${APP_UID}:${APP_GID} app/ /app/app

# Optional data dir
RUN mkdir -p /app/data && chown ${APP_UID}:${APP_GID} /app/data

ENV PYTHONPATH=/app

COPY entrypoint_pip.sh /app/entrypoint_pip.sh
RUN chmod +x /app/entrypoint_pip.sh

ENTRYPOINT ["/app/entrypoint_pip.sh"]