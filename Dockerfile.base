FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    postgresql-client \
    gcc \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app, owned by the uid the compose services run as (HOST_UID/HOST_GID, default 1000),
# so the pipeline can write state.db, dbt target/ and logs/ inside /app/app
ARG APP_UID=1000
ARG APP_GID=1000
COPY --chown=${APP_UID}:${APP_GID} app/ /app/app

# Data directory
RUN mkdir -p /app/data && chown ${APP_UID}:${APP_GID} /app/data

ENV PYTHONPATH=/app
